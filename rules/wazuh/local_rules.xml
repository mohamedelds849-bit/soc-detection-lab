<!--
  SOC Detection Lab - custom Wazuh rules
  File: /var/ossec/etc/rules/local_rules.xml  (on the Wazuh manager)

  These custom rules extend Wazuh's built-in ruleset with explicit MITRE
  ATT&CK mapping for a portfolio lab. Custom rule IDs use the 100000-120000
  range (reserved for user rules).

  Parent SIDs were checked against the Wazuh v4.9.2 ruleset
  (github.com/wazuh/wazuh/tree/v4.9.2/ruleset/rules):
    - 0095-sshd_rules.xml        : 5760 (Failed password), 5710 (invalid user), 5715 (Accepted),
                                   5763 (built-in brute force, frequency 8 / 120s)
    - 0580-win-security_rules.xml: 60122 (4625), 60106 (4624 logon success), 60109 (4720/4722),
                                   60154 (Administrators group changed, targetSid S-1-5-32-544),
                                   60228 (4698), 60117 (1102), 60204 (multiple logon failures,
                                   frequency 8 / 240s, same win.eventdata.ipAddress)
    - 0840-win_event_channel.xml : 92651/92652/92653 (remote / NTLM / RDP logon success,
                                   children of 60106, level 0-6)
    - 0280-attack_rules.xml      : 40112 (failures followed by success, level 12)
    - 0610-win-ms_logs_rules.xml : 63103 (1102 via Microsoft-Windows-Eventlog provider)
    - 0595-win-sysmon_rules.xml  : 61603 (Sysmon EID 1), 61605 (Sysmon EID 3)
    - 0600-win-wdefender_rules.xml: 62152 (Defender 5001, real-time protection disabled)
    - 0245-web_rules.xml         : 31100 (web access log grouping)
  Parent SIDs can change between Wazuh releases: ALWAYS confirm with
    /var/ossec/bin/wazuh-logtest
  after deployment. Note that Wazuh already ships similar built-in rules
  (e.g. 5763 SSH brute force, 60204 multiple Windows logon failures, 92008
  Defender disabled by PowerShell); these custom rules re-implement the logic
  with lab-specific grouping/thresholds. If a built-in sibling wins the match
  in wazuh-logtest, attach the custom rule as a child of that built-in rule.

  Rule ORDER matters. The first design assumed children are tried by DESCENDING level.
  CI on a real Wazuh 4.9.2 manager (2026-10-03) showed that built-in children loaded
  earlier still captured events before higher-level custom siblings (92653, 92652,
  31108, 92106). Robust pattern used below: attach custom rules UNDER the built-in
  child rules that may capture the event (see docs/WAZUH-VALIDATION.md section 4).
  Consequences applied below:
    - SSH brute force: built-in 5763 (level 10, 8 failures/120s, same parent 5760)
      would always win over a custom level-10 frequency rule -> 100110 is now a
      CHILD of 5763 (enrichment) instead of a competing sibling.
    - Windows logon brute force: built-in 60204 (level 10, 8 failures/240s, same
      ipAddress, child of every "authentication_failed" rule) would mask a custom
      counter -> 100121 is now a CHILD of 60204, filtered on 4625 LogonType 3/10.
      The old helper rule 100120 was removed.
    - Success-after-brute-force rules (100111, 100122, 100123) use level 13 so
      they are tried before the built-in 40112 / 40101 (level 12) siblings.
  Correlation (frequency / if_matched_sid) is per agent by default and uses the
  time the manager RECEIVED the events, not the event timestamp. When replaying
  in wazuh-logtest, paste the lines of one sequence within the timeframe.
  Validated in CI (GitHub Actions, wazuh-manager 4.9.2): 18/18 wazuh-logtest cases,
  see .github/workflows/wazuh-validation.yml and lab/expected.json.

  Regex: Wazuh's default regex engine (OSRegex) does NOT support (?i), ?, [..]
  or {n}; every field that uses PCRE syntax therefore declares type="pcre2".

  ATT&CK: Wazuh's bundled MITRE database predates ATT&CK v19 (April 2026), so the
  rules below keep T1562.001 / T1070.001. In ATT&CK v19 these were revoked and
  replaced by T1685 (Disable or Modify Tools) and T1685.005 (Clear Windows Event
  Logs); the Sigma rules use the v19 IDs.

  All rules are DETECTION only. Validate syntax with xmllint (see rules/README).
-->
<group name="soc_lab,attack,">

  <!-- =============================================================
       T1110 - SSH brute force (Linux auth.log)
       Built-in 5760 = sshd "Failed password" for an existing user.
       (Failed attempts for non-existent users hit 5710 instead; the
       built-in 5712 already correlates those.)
       ============================================================= -->
  <rule id="100110" level="10">
    <if_sid>5763</if_sid>
    <description>SSH brute force: 8+ failed logins from same source in 120s (lab enrichment of 5763)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,ssh,</group>
  </rule>

  <!-- T1110 - successful SSH login (5715) from a source that triggered
       100110 in the previous 180s. Same pattern as Wazuh's built-in 40112
       ("Multiple authentication failures followed by a success"):
       if_sid + if_matched_sid + timeframe, no frequency. Level 13 so it is
       evaluated before the level-12 built-in siblings 40101/40112. -->
  <rule id="100111" level="13" timeframe="180">
    <if_sid>5715</if_sid>
    <if_matched_sid>100110</if_matched_sid>
    <same_source_ip />
    <description>SSH successful login after brute force (possible credential compromise)</description>
    <mitre>
      <id>T1110</id>
      <id>T1078</id>
    </mitre>
    <group>authentication_success,ssh,</group>
  </rule>

  <!-- =============================================================
       T1110 - RDP / Windows logon brute force (EventID 4625)
       Enrichment of built-in 60204 ("Multiple Windows Logon Failures",
       8 failures / 240s, same win.eventdata.ipAddress). Only 4625 of logon
       type 3 (network; also RDP with NLA) or 10 (RemoteInteractive).
       ============================================================= -->
  <rule id="100121" level="10">
    <if_sid>60204</if_sid>
    <field name="win.system.eventID">^4625$</field>
    <field name="win.eventdata.logonType" type="pcre2">^(3|10)$</field>
    <description>RDP/Windows brute force: 8+ failed network/RDP logons from $(win.eventdata.ipAddress)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,windows,</group>
  </rule>

  <!-- =============================================================
       T1110 + T1078 - remote logon SUCCESS after the brute force (rule 12)
       Built-in 60106 = "Windows Logon Success" (4624). In CI its built-in
       children 92651 -> 92653 (RDP) / 92652 (NTLM) captured the event first,
       so 100122 / 100123 are also attached under 92653 / 92652.
       100122: RDP (logonType 10).
       100123: network logon (logonType 3) with NTLM - NLA credential check,
               SMB/WinRM password guessing, pass-the-hash.
       Both require a 100121 alert for the same ipAddress in the last 180s.
       ============================================================= -->
  <rule id="100122" level="13" timeframe="180">
    <!-- CI finding (Wazuh 4.9.2): built-in children of 60106 are evaluated in LOAD order, not by level, so
         92651 -> 92653 (RDP logon, lvl 3) captured the event. Attach under 92653 too. -->
    <if_sid>60106, 92653</if_sid>
    <if_matched_sid>100121</if_matched_sid>
    <same_field>win.eventdata.ipAddress</same_field>
    <field name="win.system.eventID">^4624$</field>
    <field name="win.eventdata.logonType" type="pcre2">^10$</field>
    <description>RDP logon success for $(win.eventdata.targetUserName) from $(win.eventdata.ipAddress) after brute force (account likely compromised)</description>
    <mitre>
      <id>T1110</id>
      <id>T1078</id>
    </mitre>
    <group>authentication_success,windows,</group>
  </rule>

  <rule id="100123" level="13" timeframe="180">
    <!-- CI finding: 92651 -> 92652 (NTLM remote logon, lvl 6) captured the event. Attach under 92652 too. -->
    <if_sid>60106, 92652</if_sid>
    <if_matched_sid>100121</if_matched_sid>
    <same_field>win.eventdata.ipAddress</same_field>
    <field name="win.system.eventID">^4624$</field>
    <field name="win.eventdata.logonType" type="pcre2">^3$</field>
    <field name="win.eventdata.authenticationPackageName" type="pcre2">(?i)^NTLM$</field>
    <description>NTLM network logon success for $(win.eventdata.targetUserName) from $(win.eventdata.ipAddress) after brute force (account likely compromised)</description>
    <mitre>
      <id>T1110</id>
      <id>T1078</id>
    </mitre>
    <group>authentication_success,windows,</group>
  </rule>

  <!-- =============================================================
       T1136.001 / T1098 - new local user then added to Administrators
       ============================================================= -->
  <rule id="100130" level="6">
    <if_sid>60109</if_sid>
    <field name="win.system.eventID">^4720$</field>
    <description>Windows local user account created (EventID 4720)</description>
    <mitre>
      <id>T1136.001</id>
    </mitre>
    <group>account_changes,windows,</group>
  </rule>

  <!-- Built-in 60154 = Administrators group changed (targetSid S-1-5-32-544,
       language-independent: the group is "Administrateurs" on French Windows).
       60154 covers both 4732 (added) and 4733 (removed) -> keep the eventID filter.
       Limitation: Wazuh's same_field compares ONE field name in both events, so
       it cannot join 4720 targetSid with 4732 memberSid. Correlation is per
       agent (host) by default, so this rule can fire for "account A created,
       then unrelated account B added to Administrators" on the same host. The
       engine and Sigma versions join on the SID; here the analyst must compare
       targetSid (100130) with memberSid (100131) during triage. -->
  <rule id="100131" level="10" timeframe="120">
    <if_sid>60154</if_sid>
    <field name="win.system.eventID">^4732$</field>
    <if_matched_sid>100130</if_matched_sid>
    <description>New local account added to Administrators group (persistence/privilege)</description>
    <mitre>
      <id>T1098</id>
      <id>T1136.001</id>
    </mitre>
    <group>account_changes,windows,</group>
  </rule>

  <!-- =============================================================
       T1059.001 - suspicious PowerShell encoded command (Sysmon EID 1)
       ============================================================= -->
  <rule id="100140" level="10">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(powershell|pwsh)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s-(e|ec|en|enc|enco|encodedcommand)\s</field>
    <description>Suspicious PowerShell encoded command (-EncodedCommand)</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
    <group>powershell,sysmon,</group>
  </rule>

  <!-- =============================================================
       T1053.005 - scheduled task created (Security 4698 or schtasks.exe)
       4698 requires the audit subcategory "Other Object Access Events".
       ============================================================= -->
  <rule id="100150" level="7">
    <if_sid>60228</if_sid>
    <field name="win.system.eventID">^4698$</field>
    <description>Scheduled task created (EventID 4698)</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
    <group>persistence,windows,</group>
  </rule>

  <rule id="100151" level="7">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\schtasks\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)/create</field>
    <description>Scheduled task created via schtasks.exe</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
    <group>persistence,sysmon,</group>
  </rule>

  <!-- =============================================================
       T1070.001 (ATT&CK v19: T1685.005) - Security log cleared (1102)
       Depending on how the event is classified it reaches 60117
       (Security informational) or 63103 (Eventlog provider) - both listed.
       ============================================================= -->
  <rule id="100160" level="12">
    <if_sid>60117, 63103</if_sid>
    <field name="win.system.eventID">^1102$</field>
    <description>Windows Security audit log cleared (anti-forensics)</description>
    <mitre>
      <id>T1070.001</id>
    </mitre>
    <group>defense_evasion,windows,</group>
  </rule>

  <!-- =============================================================
       T1046 - port scan from single source (many network connections)
       Sysmon EID 3 = network connection. NOTE: this counts connections,
       not DISTINCT ports (the Sigma/engine versions count distinct ports).
       Sysmon only logs connections it observes and community configs
       filter EID 3 heavily - see docs/SETUP.md.
       ============================================================= -->
  <rule id="100170" level="3">
    <!-- CI finding: some EID 3 events end on built-in sysmon_id_3 rules (e.g. 92105 -> 92106, SMB), so the counter
         missed them. Attach under 61605 and every built-in EID 3 rule (0810-sysmon_id_3.xml, 4.9.2). -->
    <if_sid>61605, 92101, 92102, 92103, 92104, 92105, 92106, 92107, 92108, 92109, 92110</if_sid>
    <description>Sysmon network connection (EventID 3)</description>
    <options>no_full_log</options>
    <group>network,sysmon,</group>
  </rule>

  <rule id="100171" level="10" frequency="15" timeframe="60">
    <if_matched_sid>100170</if_matched_sid>
    <same_field>win.eventdata.sourceIp</same_field>
    <description>Port scan: 15+ network connections from same source in 60s</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>discovery,sysmon,</group>
  </rule>

  <!-- =============================================================
       T1562.001 (ATT&CK v19: T1685) - Defender real-time protection disabled
       100180: the attempt (command line, Sysmon EID 1)
       100181: the state change (Defender Operational EventID 5001). It also
               catches GUI/GPO disabling, and stays silent when Tamper
               Protection blocked the command.
       ============================================================= -->
  <rule id="100180" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)DisableRealtimeMonitoring</field>
    <description>Microsoft Defender real-time monitoring disable attempt (defense evasion)</description>
    <mitre>
      <id>T1562.001</id>
    </mitre>
    <group>defense_evasion,sysmon,</group>
  </rule>

  <rule id="100181" level="12">
    <if_sid>62152</if_sid>
    <field name="win.system.eventID">^5001$</field>
    <description>Microsoft Defender real-time protection is disabled (EventID 5001)</description>
    <mitre>
      <id>T1562.001</id>
    </mitre>
    <group>defense_evasion,windows,</group>
  </rule>

  <!-- =============================================================
       T1505.003 - web shell interaction, behaviour-based (no file names)
       Built-in decoder web-accesslog fills srcip, protocol (= HTTP method),
       url (path + query) and id (= status code). These level-10 children of
       31100 are tried before the built-in 31103/31104/31108 (levels 0-7).
       100190: OS command in a command-style parameter
       100191: PHP code-execution call or base64 payload in a command parameter
       100192: successful POST to a script inside an upload directory
       "evaluation", "whoami" in q=..., id=42 ... must NOT match.
       ============================================================= -->
  <rule id="100190" level="10">
    <if_sid>31100</if_sid>
    <url type="pcre2">(?i)[?&amp;](cmd|exec|command|execute|run|c)=(?:[^&amp;]*?(?:\+|%20|%3B|%7C|;|\|))?(?:whoami|id|uname|hostname|ipconfig|ifconfig|pwd|net(?:\+|%20)+(?:user|localgroup)|cat(?:\+|%20)+(?:/|%2F)etc(?:/|%2F)passwd|ls(?:\+|%20)+-[a-z]*)(?=$|&amp;|\+|%20|%3B|%7C)</url>
    <description>Web shell: OS command passed in a command parameter ($(url))</description>
    <mitre>
      <id>T1505.003</id>
    </mitre>
    <group>web,attack,web_shell,</group>
  </rule>

  <rule id="100191" level="10">
    <if_sid>31100</if_sid>
    <url type="pcre2">(?i)(?:\b(?:eval|assert|system|passthru|shell_exec|base64_decode)(?:\(|%28))|[?&amp;](?:cmd|exec|command|execute)=(?=[^&amp;]*\d)(?:[A-Za-z0-9+/]|%2B|%2F){16,}(?:=|%3D){0,2}(?:&amp;|$)</url>
    <description>Web shell: PHP code execution or encoded payload in request ($(url))</description>
    <mitre>
      <id>T1505.003</id>
    </mitre>
    <group>web,attack,web_shell,</group>
  </rule>

  <rule id="100192" level="10">
    <!-- 31108 (level 0, "simple queries") is evaluated before custom siblings and captures
         successful requests WITHOUT a query string, so attach to it as well (same pattern as Wazuh's own 31103). -->
    <if_sid>31100,31108</if_sid>
    <protocol>POST</protocol>
    <id type="pcre2">^20[0124]$</id>
    <url type="pcre2">(?i)/(?:uploads?|files|media|tmp)/(?:[^?#]*/)?[^/?#]+\.(?:php\d?|phtml|phar)(?:\?|$)</url>
    <description>Web shell: successful POST to a script in an upload directory ($(url))</description>
    <mitre>
      <id>T1505.003</id>
    </mitre>
    <group>web,attack,web_shell,</group>
  </rule>

  <!-- =============================================================
       T1204.002 - Office application spawning a command shell (Sysmon EID 1)
       ============================================================= -->
  <rule id="100200" level="10">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\(winword|excel|powerpnt|outlook|msaccess)\.exe$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$</field>
    <description>Office application spawned a command interpreter (malicious document)</description>
    <mitre>
      <id>T1204.002</id>
    </mitre>
    <group>execution,sysmon,</group>
  </rule>

</group>
